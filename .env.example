# ============================================================================
#  Fin B — credentials
# ============================================================================
#  HOW TO USE
#    1. Copy this file to `.env` in this same folder (D:\Fin B\.env)
#    2. Fill in ONLY the lines for services you actually have.
#       Leave everything else exactly as-is. The engine auto-detects which
#       providers are configured and silently skips the rest.
#    3. `.env` is gitignored. Never paste these values into a chat window.
#
#  Run `uv run finb doctor` after editing to see what was detected.
# ============================================================================


# ---------------------------------------------------------------------------
#  SAFETY GUARD  — do not change this without understanding what it does.
# ---------------------------------------------------------------------------
#  Everything in this project is paper/simulated. This flag is the single
#  switch that would ever permit real-money orders. It must be the literal
#  string "I_UNDERSTAND_THIS_TRADES_REAL_MONEY" to have any effect, and the
#  engine additionally refuses to start live unless a strategy has passed the
#  promotion gate. Leave it as `no`.
FINB_ALLOW_LIVE=no

#  Simulated capital allocated to the whole farm, in USD.
FINB_CAPITAL_USD=500


# ---------------------------------------------------------------------------
#  BROKER — Alpaca (US equities + crypto, one API)
# ---------------------------------------------------------------------------
#  Paper keys from: https://app.alpaca.markets/  ->  "Paper Trading" -> API Keys
#  PAPER KEYS ONLY. Do not put live keys in this file.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true


# ---------------------------------------------------------------------------
#  CRYPTO EXCHANGE — fill in whichever ONE (or more) you have.
# ---------------------------------------------------------------------------
#  Note: public market data (candles, trades, order books) needs NO key on
#  every one of these. Keys are only needed to place testnet orders.
#  US residents: Binance.com is geo-blocked; use Binance.US, Kraken, or Coinbase.

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_US=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_DEMO=true

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

COINBASE_API_KEY=
COINBASE_API_SECRET=


# ---------------------------------------------------------------------------
#  MARKET DATA PROVIDERS — fill in whichever you have.
# ---------------------------------------------------------------------------
POLYGON_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
EODHD_API_KEY=

#  FRED — the best free macro source there is. Key is free and instant:
#  https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=


# ---------------------------------------------------------------------------
#  NEWS / SENTIMENT
# ---------------------------------------------------------------------------
#  Alpaca's news feed uses the ALPACA_* keys above — nothing extra needed.
NEWSAPI_KEY=
MARKETAUX_API_KEY=


# ---------------------------------------------------------------------------
#  PATHS  (defaults are fine; override only if you move things)
# ---------------------------------------------------------------------------
# FINB_VAULT_DIR=D:\Fin B
# FINB_DATA_DIR=D:\Fin B\data
# FINB_LOG_DIR=D:\Fin B\logs
